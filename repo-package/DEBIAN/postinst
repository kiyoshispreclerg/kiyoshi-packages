#!/bin/sh
set -e
. /usr/share/debconf/confmodule

URL="@URL@"
LIST=/etc/apt/sources.list.d/kiyoshi-packages.sources

if [ "$1" = configure ]; then
    codename() {
        [ -r /etc/os-release ] && . /etc/os-release
        for c in "${UBUNTU_CODENAME:-}" "${VERSION_CODENAME:-}"; do
            case "$c" in
                jammy|noble|resolute|bookworm|trixie) echo "$c"; return ;;
                daedalus) echo bookworm; return ;;
                excalibur) echo trixie; return ;;
            esac
        done
        case "$(cut -d. -f1 /etc/debian_version 2>/dev/null)" in
            12) echo bookworm ;;
            13) echo trixie ;;
        esac
    }
    suite="$(codename)"
    if [ -z "$suite" ]; then
        echo "kiyoshi-packages-repo: unsupported system, no apt source written" >&2
        echo "(supported: Ubuntu 22.04/24.04/26.04, Debian 12/13, Devuan 5/6)" >&2
    else
        # A manual setup for the same repository (other Signed-By) would make
        # apt refuse both: set aside the files that only hold this repository.
        for f in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
            [ -f "$f" ] && [ "$f" != "$LIST" ] || continue
            grep -qF "$URL" "$f" || continue
            # entry lines: "deb ..." in .list files, "URIs:" in .sources files
            others="$(grep -E '^[[:space:]]*(deb|deb-src|URIs:)' "$f" | grep -cvF "$URL" || true)"
            if [ "$others" -eq 0 ]; then
                mv "$f" "$f.save"
                echo "kiyoshi-packages-repo: $f replaced by $LIST (old file kept as $f.save)"
            else
                echo "kiyoshi-packages-repo: $f also lists this repository; remove it if apt reports a Signed-By conflict" >&2
            fi
        done
        db_get kiyoshi-packages-repo/channel || RET=none
        comps=main
        case "$RET" in stable|beta) comps="main $RET" ;; esac
        cat > "$LIST" <<SRC
# Generated by kiyoshi-packages-repo; change the channel with
# dpkg-reconfigure kiyoshi-packages-repo
Types: deb
URIs: $URL
Suites: $suite
Components: $comps
Signed-By: /usr/share/keyrings/kiyoshi-packages.gpg
SRC
    fi
fi
db_stop || true
exit 0
