#!/bin/sh
# startxis - like startx(1), but with the XiS X server from @PREFIX@.
#
#   startxis [client args] [-- [display] [server args]]
#
# Everything is passed to startx, with the XiS server inserted right after "--"
# (added if missing) and "-nolisten tcp" at the end, which is what the
# distribution's xserverrc would otherwise have supplied.

PREFIX=@PREFIX@
server="$PREFIX/bin/Xorg"

case "${1:-}" in
    -h|--help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
esac

if [ ! -x "$server" ]; then
    echo "startxis: $server not found; is the xis-server package installed?" >&2
    exit 1
fi
if ! command -v startx >/dev/null 2>&1; then
    echo "startxis: startx not found; install the xinit package" >&2
    exit 1
fi

# Rebuild the argument list: rotate through it once, inserting the server after
# the first "--"; this keeps every argument intact (POSIX sh has no arrays).
n=$#
done_sep=no
nolisten=no
while [ "$n" -gt 0 ]; do
    a=$1
    shift
    n=$((n - 1))
    if [ "$a" = "-nolisten" ] && [ "$done_sep" = yes ]; then nolisten=yes; fi
    if [ "$a" = "--" ] && [ "$done_sep" = no ]; then
        set -- "$@" -- "$server"
        done_sep=yes
    else
        set -- "$@" "$a"
    fi
done
[ "$done_sep" = yes ] || set -- "$@" -- "$server"
[ "$nolisten" = yes ] || set -- "$@" -nolisten tcp

exec startx "$@"
