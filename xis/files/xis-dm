#!/bin/sh
# xis-dm - make the display manager start the XiS X server, or stop doing so.
#
#   xis-dm status
#   xis-dm enable  [lightdm|sddm]
#   xis-dm disable [lightdm|sddm]
#
# Only writes a drop-in file of its own (never edits the display manager's main
# configuration), so "disable" is just removing it. Nothing happens until the
# display manager is restarted; restarting it ends the running graphical
# session, so this script never does that for you.
#
# Supported: LightDM and SDDM. For others the line to add is printed.

set -eu

PREFIX=@PREFIX@
SERVER="$PREFIX/bin/Xorg"
ROOT="${XIS_DM_ROOT:-}"          # only for testing: prefix for /etc paths

conf_lightdm="$ROOT/etc/lightdm/lightdm.conf.d/50-xis.conf"
conf_sddm="$ROOT/etc/sddm.conf.d/50-xis.conf"

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }
die()   { echo "xis-dm: $*" >&2; exit 1; }

# Debian and Ubuntu record the display manager that starts at boot here.
detect_dm() {
    f="$ROOT/etc/X11/default-display-manager"
    [ -r "$f" ] && basename "$(cat "$f")" || true
}

need_root() {
    [ -n "$ROOT" ] || [ "$(id -u)" -eq 0 ] || die "must be run as root (try: sudo xis-dm $1)"
}

conf_for() {
    case "$1" in
        lightdm) echo "$conf_lightdm" ;;
        sddm)    echo "$conf_sddm" ;;
        *)       return 1 ;;
    esac
}

# The XiS server also reads /etc/X11/xorg.conf and xorg.conf.d. A Driver or
# ModulePath written for the distribution's Xorg points at modules that XiS
# (which only looks under $PREFIX/lib/xorg/modules) will not find.
warn_config() {
    out="$(grep -sHE '^[[:space:]]*(Driver|ModulePath)[[:space:]]' \
               "$ROOT/etc/X11/xorg.conf" "$ROOT"/etc/X11/xorg.conf.d/*.conf \
           | grep -viE 'Driver[[:space:]]+"(modesetting|libinput)"' || true)"
    if [ -n "$out" ]; then
        echo "warning: these lines in your Xorg configuration are read by XiS too;" >&2
        echo "         drivers that are not installed under $PREFIX will fail to load:" >&2
        echo "$out" | sed 's/^/           /' >&2
    fi
}

manual() {
    echo "xis-dm cannot configure '$1' automatically." >&2
    case "$1" in
        gdm|gdm3) echo "GDM has no setting for the X server binary; use startxis from a console instead." >&2 ;;
        slim)     echo "In /etc/slim.conf set:  default_xserver $SERVER" >&2 ;;
        lxdm)     echo "In /etc/lxdm/lxdm.conf, section [server], set:  arg=$SERVER" >&2 ;;
        xdm)      echo "In /etc/X11/xdm/Xservers use:  :0 local $SERVER :0 vt7" >&2 ;;
        *)        echo "Point its X server setting at $SERVER." >&2 ;;
    esac
    exit 2
}

cmd_enable() {
    dm="${1:-$(detect_dm)}"
    [ -n "$dm" ] || die "cannot tell which display manager is in use; run: xis-dm enable lightdm|sddm"
    conf="$(conf_for "$dm")" || manual "$dm"
    [ -x "$SERVER" ] || die "$SERVER not found; is the xis-server package installed?"
    need_root enable
    mkdir -p "$(dirname "$conf")"
    case "$dm" in
        lightdm) printf '# Managed by xis-dm. Remove with: xis-dm disable\n[Seat:*]\nxserver-command=%s\n' "$SERVER" > "$conf" ;;
        sddm)    printf '# Managed by xis-dm. Remove with: xis-dm disable\n[X11]\nServerPath=%s\n' "$SERVER" > "$conf" ;;
    esac
    echo "$dm: now configured to start $SERVER ($conf)"
    warn_config
    echo "It takes effect the next time $dm starts. Restarting it now would end your session."
}

cmd_disable() {
    need_root disable
    found=no
    for dm in ${1:-lightdm sddm}; do
        conf="$(conf_for "$dm")" || manual "$dm"
        if [ -e "$conf" ]; then
            rm -f "$conf"
            echo "$dm: back to the distribution's X server ($conf removed)"
            found=yes
        fi
    done
    [ "$found" = yes ] || echo "nothing to disable"
}

cmd_status() {
    echo "XiS server:       $SERVER $([ -x "$SERVER" ] && echo '(installed)' || echo '(NOT FOUND)')"
    echo "display manager:  $(detect_dm | grep . || echo unknown)"
    for dm in lightdm sddm; do
        conf="$(conf_for "$dm")"
        if [ -e "$conf" ]; then echo "$dm:  XiS enabled ($conf)"; else echo "$dm:  not enabled"; fi
    done
}

case "${1:-}" in
    enable)  shift; cmd_enable "$@" ;;
    disable) shift; cmd_disable "$@" ;;
    status)  cmd_status ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 1 ;;
esac
