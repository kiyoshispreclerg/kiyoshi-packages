From 569787fcb (X11Libre/xserver, master, 2026-04-04): meson.build: Lower libdrm version requirement
Backported to the 25.1 tree: libdrm 2.4.116 was only needed for the
DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP constant, which present.c now defines itself when
the headers lack it. Lets 25.1.x build on Ubuntu 22.04 (libdrm 2.4.113) and
Debian 12 (2.4.114). The 25.2 releases already carry it.

diff --git a/hw/xfree86/drivers/video/modesetting/present.c b/hw/xfree86/drivers/video/modesetting/present.c
index c531bc814d1..bc088103b71 100644
--- a/hw/xfree86/drivers/video/modesetting/present.c
+++ b/hw/xfree86/drivers/video/modesetting/present.c
@@ -535,6 +535,10 @@ ms_present_screen_init(ScreenPtr screen)
     uint64_t value;
     int ret;
 
+#ifndef DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP
+#define DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP 0x15
+#endif
+
     ret = drmGetCap(ms->fd, ms->atomic_modeset ?
                             DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP :
                             DRM_CAP_ASYNC_PAGE_FLIP, &value);
diff --git a/meson.build b/meson.build
index 57f9b316f62..39aefe176cd 100644
--- a/meson.build
+++ b/meson.build
@@ -83,7 +83,7 @@ endforeach
 
 add_project_arguments(common_wflags, language : ['c', 'objc'])
 
-libdrm_req = '>= 2.4.116'
+libdrm_req = '>= 2.4.89'
 libselinux_req = '>= 2.0.86'
 xext_req = '>= 1.0.99.4'
 xproto_req = '>= 7.0.31'
