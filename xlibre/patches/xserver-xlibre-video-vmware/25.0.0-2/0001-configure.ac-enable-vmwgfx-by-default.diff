From 06279d34a1b469c1e881a74d1982b99947d4ea37 Mon Sep 17 00:00:00 2001
From: Kiyoshi PiP <kiyoshispreclerg@gmail.com>
Date: Tue, 19 May 2026 11:00:03 -0300
Subject: [PATCH] configure.ac: enable vmwgfx by default

We support only recent Xservers, and they support vmwgfx, so we can set BUILD_VMWGFX to yes at first, as this was not set to yes by default since f0c20d7fca1734034667bef53d2b1c8243501561.

Fixes https://github.com/X11Libre/xf86-video-vmware/issues/18

Signed-off-by: Kiyoshi Spreclerg <kiyoshi_pip@protonmail.com>
---
 configure.ac | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/configure.ac b/configure.ac
index 7c758d2..1aba773 100644
--- a/configure.ac
+++ b/configure.ac
@@ -70,6 +70,9 @@ XORG_DRIVER_CHECK_EXT(DPMSExtension, xextproto)
 XORG_DRIVER_CHECK_EXT(XINERAMA, xineramaproto)
 XORG_DRIVER_CHECK_EXT(XV, videoproto)
 
+# Enable vmwgfx by default
+BUILD_VMWGFX=yes
+
 # Obtain compiler/linker options for the driver dependencies
 PKG_CHECK_MODULES(XORG, [xorg-server >= 25.0.0 xproto fontsproto $REQUIRED_MODULES])
 
@@ -79,9 +82,8 @@ PKG_CHECK_MODULES([PCIACCESS], [pciaccess >= 0.8.0])
 
 AC_SUBST([moduledir])
 
-if test x$BUILD_VMWGFX = xyes; then
-	PKG_CHECK_MODULES([LIBDRM], [libdrm],[],[BUILD_VMWGFX=no])
-fi
+PKG_CHECK_MODULES([LIBDRM], [libdrm],[],[BUILD_VMWGFX=no])
+
 if test x$BUILD_VMWGFX = xyes; then
 #
 # Early versions of mesa 10 forgot to bump the XA major version number in
